# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" itself is git-ignored on purpose — never commit real keys.
#
# Where to find these: Supabase dashboard → your project → Project Settings
# → API. Use the "Project URL" and the publishable/anon "public" key — NOT
# the "service_role" key, which must never be used in this file or anywhere
# in the browser-side app.
#
# For the live site on Vercel, set these same two variables in the Vercel
# project's Settings → Environment Variables instead of shipping this file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
